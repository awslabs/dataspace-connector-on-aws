{
  "name": "dataspace-connector-on-aws",
  "version": "2.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "prebuild": "npm run format",
    "clean": "rm -rf build dist cdk.out node_modules",
    "watch": "tsc -w",
    "prepare": "npm run-script build",
    "lint": "eslint --cache lib && prettier --list-different --cache .",
    "format": "eslint --fix --cache lib && prettier --write --cache .",
    "build": "tsc && cdk synth",
    "test": "jest",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1084.0",
    "@aws-sdk/client-dynamodb": "^3.1084.0",
    "@aws-sdk/client-secrets-manager": "^3.1084.0",
    "@aws-sdk/lib-dynamodb": "^3.1084.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.6.0",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
